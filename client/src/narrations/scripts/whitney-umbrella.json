{
  "id": "whitney-umbrella",
  "title": "惠特尼伞",
  "subtitle": "光滑映射的稳定奇点",
  "difficulty": "expert",
  "targetAge": "研究生+",
  "voice": "yunxi",
  "meta": {
    "version": "1.0.0",
    "createdAt": "2026-07-29",
    "updatedAt": "2026-07-29"
  },
  "objectives": [
    "理解浸入的定义与雅可比满秩的关系",
    "认识平面到空间映射的两类稳定奇点",
    "掌握伞点与横截自交的区别",
    "体会奇点分类定理的意义"
  ],
  "prerequisites": [
    "雅可比矩阵",
    "浸入与嵌入",
    "多元微积分"
  ],
  "sections": [
    {
      "id": "intro",
      "type": "intro",
      "title": "映射会出什么毛病",
      "lines": [
        {
          "id": "intro-1",
          "text": "把一张平面光滑地映到三维空间里，通常得到一张曲面。但有时会出毛病，曲面上出现不光滑的地方。"
        },
        {
          "id": "intro-2",
          "text": "惠特尼在一九四四年问了一个根本问题：这些毛病有多少种？答案出人意料地简洁。"
        },
        {
          "id": "intro-3",
          "text": "在一般位置下只有两类：两片横截相交成一条线，以及自交线终止于一个尖点。后者就是惠特尼伞。"
        }
      ]
    },
    {
      "id": "map",
      "type": "formula",
      "title": "极简的公式",
      "lines": [
        {
          "id": "mp-1",
          "text": "惠特尼伞的映射简单到只有三个单项式。参数 u 和 v 映到 u 乘 v、u 本身、以及 v 的平方。"
        },
        {
          "id": "mp-2",
          "text": "消去参数可以得到隐式方程：x 的平方等于 y 的平方乘 z。屏幕上的残差读数精确为零。"
        },
        {
          "id": "mp-3",
          "text": "注意 z 等于 v 的平方，所以 z 永远非负。整张曲面只存在于上半空间。"
        }
      ]
    },
    {
      "id": "selfcross",
      "type": "animation",
      "title": "自交线在哪里",
      "lines": [
        {
          "id": "sc-1",
          "text": "先找自交。取 u 等于零，那么横坐标和纵坐标都是零，只剩 z 等于 v 的平方。"
        },
        {
          "id": "sc-2",
          "text": "关键在于 v 和负 v 给出同一个 z。也就是说参数平面上两条不同的线被映到了空间中同一条线上。"
        },
        {
          "id": "sc-3",
          "text": "这条重合的线就是自交线，它位于 z 轴的正半轴。画面上高亮的那条竖线就是它。"
        }
      ]
    },
    {
      "id": "jacobian",
      "type": "concept",
      "title": "雅可比在哪里退化",
      "lines": [
        {
          "id": "jc-1",
          "text": "自交本身不算奇点，两片光滑曲面穿过彼此是允许的。真正的奇点在于映射不再是浸入。"
        },
        {
          "id": "jc-2",
          "text": "浸入的判据是雅可比矩阵满秩。这里雅可比的两列分别是 v、一、零，以及 u、零、二 v。"
        },
        {
          "id": "jc-3",
          "text": "在原点处第二列全是零，秩从二掉到一，映射不再是浸入。这个点就是伞点，也是自交线的终点。"
        }
      ]
    },
    {
      "id": "distinguish",
      "type": "interaction",
      "title": "伞点与普通自交的区别",
      "lines": [
        {
          "id": "ds-1",
          "text": "怎么直观区分伞点和普通的横截自交？看两片曲面在自交线上的夹角。"
        },
        {
          "id": "ds-2",
          "text": "沿自交线向伞点靠近时，夹角越来越小。在离伞点很近的地方，两片几乎完全贴合。"
        },
        {
          "id": "ds-3",
          "text": "而普通的横截自交处，夹角始终保持有限。请留意屏幕上的夹角读数，它从近八十度一路降到几度。"
        }
      ]
    },
    {
      "id": "summary",
      "type": "summary",
      "title": "回顾",
      "lines": [
        {
          "id": "sum-1",
          "text": "第一，平面到空间的光滑映射在一般位置下只有两类稳定奇点。"
        },
        {
          "id": "sum-2",
          "text": "第二，惠特尼伞是其中一类的标准模型，映射为 u v、u、v 的平方。"
        },
        {
          "id": "sum-3",
          "text": "第三，原点处雅可比退化，不再是浸入，两片曲面在此贴合。感谢观看，我们下次再见。"
        }
      ]
    }
  ]
}